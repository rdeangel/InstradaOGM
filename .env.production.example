# ============================================================================
# InstradaOGM Production Environment Configuration - EXAMPLE FILE
# ============================================================================
# This file contains ONLY production-specific settings that differ from defaults.
# Copy this to .env.production.local and customize for your production deployment.
#
# IMPORTANT:
# - Base configuration is in .env (committed to git)
# - This file shows ONLY production overrides
# - Never commit .env.production.local to version control
# - See .env.example for complete variable documentation
# ============================================================================

# ============================================================================
# HTTP/HTTPS Configuration (Production)
# ============================================================================

# Enforce HTTPS only (production security requirement)
ALLOW_HTTP=false

# Production domain with HTTPS
# Must match your SSL certificate domain
NEXTAUTH_URL="https://your-instrada-ogm.com"

# For Traefik/reverse proxy deployments (domain without protocol)
DOMAIN=your-instrada-ogm.com

# ============================================================================
# Data Folder Configuration (Optional - Non-Docker Deployments)
# ============================================================================

# For system-wide installations following Linux conventions:
# DATA_FOLDER_PATH=/var/lib/instrada-ogm/data

# For Docker deployments: Leave unset (uses default ./data with volume mounts)

# ============================================================================
# Logging Configuration
# ============================================================================

# Production logging - errors and warnings only
APP_DEBUG_LEVEL=ERROR

# ============================================================================
# Database Configuration (PostgreSQL Recommended)
# ============================================================================

# PostgreSQL for production (required for high-traffic deployments)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://ogm_user:CHANGE_ME_secure_password@localhost:5432/instrada_ogm

# ============================================================================
# Authentication \u0026 Security
# ============================================================================

# NextAuth Secret - MUST be generated securely
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Session duration (30 days default)
SSO_MAX_AGE=2592000

# ============================================================================
# Local Authentication (Optional - Disable if using SSO only)
# ============================================================================

# Disable local login if using SSO exclusively
# AUTH_ALLOW_LOCAL_LOGIN=false

# Require email verification for local accounts (requires SMTP)
# AUTH_REQUIRE_VERIFIED_EMAIL_LOCAL=true

# ============================================================================
# SMTP Configuration (Required if using email verification or password reset)
# ============================================================================

# AUTH_SMTP_HOST=smtp.gmail.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=your-email@gmail.com
# AUTH_SMTP_PASS=your-app-specific-password
# AUTH_SMTP_FROM_EMAIL=noreply@your-instrada-ogm.com

# ============================================================================
# SSO/OIDC Configuration (Optional - Recommended for Production)
# ============================================================================

# Enable OIDC authentication
# AUTH_ALLOW_OIDC_LOGIN=true

# Example: Authentik Provider
# AUTH_OIDC_PROVIDER_AUTHENTIK_ENABLED=true
# AUTH_OIDC_PROVIDER_AUTHENTIK_CLIENT_ID=your_client_id
# AUTH_OIDC_PROVIDER_AUTHENTIK_CLIENT_SECRET=your_client_secret
# AUTH_OIDC_PROVIDER_AUTHENTIK_ISSUER=https://auth.your-domain.com/application/o/instrada-ogm/
# AUTH_OIDC_PROVIDER_AUTHENTIK_DISPLAY_NAME="Company SSO"

# Example: Keycloak Provider
# AUTH_OIDC_PROVIDER_KEYCLOAK_ENABLED=true
# AUTH_OIDC_PROVIDER_KEYCLOAK_CLIENT_ID=your_client_id
# AUTH_OIDC_PROVIDER_KEYCLOAK_CLIENT_SECRET=your_client_secret
# AUTH_OIDC_PROVIDER_KEYCLOAK_ISSUER=https://keycloak.your-domain.com/realms/your-realm
# AUTH_OIDC_PROVIDER_KEYCLOAK_DISPLAY_NAME="Keycloak SSO"

# ============================================================================
# OPNsense Configuration
# ============================================================================

# Production OPNsense instance
OPNSENSE_URL=https://your-production-opnsense.domain.com
OPNSENSE_API_KEY=CHANGE_ME_your_production_api_key
OPNSENSE_API_SECRET=CHANGE_ME_your_production_api_secret

# Always verify SSL in production (security requirement)
SKIP_SSL_VERIFICATION=false

# ============================================================================
# Backup Encryption
# ============================================================================

# Backup Encryption Secret Key - Generate securely
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_SECRET_KEY=CHANGE_ME_your_production_64_character_hex_key_here

# ============================================================================
# Update Checks (Optional)
# ============================================================================

# Enable automatic update checks (default: true)
# AUTO_UPDATE_CHECK=true

# ============================================================================
# Advanced Configuration (Usually Not Needed)
# ============================================================================

# Internal server-to-server URL (only if different from NEXTAUTH_URL)
# Common in Docker/Kubernetes with internal service names
# INTERNAL_APP_URL=http://app:3000

# Custom application port (default: 3000)
# PORT=3000

# ============================================================================
# Production Security Checklist
# ============================================================================
#
# Before deploying to production, ensure:
#
# ✅ HTTPS Configuration:
#    - ALLOW_HTTP=false
#    - Valid SSL/TLS certificates installed
#    - NEXTAUTH_URL uses https://
#
# ✅ Secrets:
#    - NEXTAUTH_SECRET generated with openssl rand -base64 32
#    - BACKUP_ENCRYPTION_SECRET_KEY generated with openssl rand -hex 32
#    - All passwords are strong and unique
#    - .env.production.local is in .gitignore
#
# ✅ Database:
#    - Using PostgreSQL (not SQLite)
#    - Database password is strong
#    - Database access restricted to app server
#    - Regular backups configured
#
# ✅ OPNsense:
#    - API keys have minimal required permissions
#    - SKIP_SSL_VERIFICATION=false
#    - API credentials rotated regularly
#
# ✅ Logging:
#    - APP_DEBUG_LEVEL=ERROR
#    - Log monitoring configured
#    - Alerts set up for critical errors
#
# ✅ Authentication:
#    - SSO/OIDC configured (recommended)
#    - Email verification enabled if using local auth
#    - 2FA enabled for admin accounts
#
# See .env.example for complete variable documentation
# See docs/SETUP/ENVIRONMENT_SETUP_GUIDE.md for detailed configuration guide
#

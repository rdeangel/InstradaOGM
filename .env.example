# =============================================================================
# InstradaOGM - Complete Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your setup
# This file documents ALL available environment variables
# =============================================================================

# =============================================================================
# APPLICATION METADATA
# =============================================================================

# Application version (automatically set from package.json during build)
# Only set this manually if you need to override the version for Docker builds
# NEXT_PUBLIC_APP_VERSION=x.x.x

# Update Detection - Mock Mode (DEVELOPMENT/TESTING ONLY)
# Set to "true" to simulate an available update for testing the update notification system
# This is useful before publishing your first GitHub release
# ⚠️ WARNING: Only use in development - remove or set to "false" in production
# MOCK_UPDATE_AVAILABLE=false

# Update Detection - Automatic Check Control
# Set to "true" to enable automatic update checks (default behavior)
# Set to "false" to disable automatic update checks to GitHub
# When disabled:
#   - No update check will be performed at startup
#   - No periodic update checks will run (every 6 hours)
#   - Manual checks from the Settings/Updates tab will still work
#   - A grey badge will be shown in the Updates tab to indicate auto-check is disabled
# Default: true (enabled)
AUTO_UPDATE_CHECK=true

# =============================================================================
# OPNsense Firewall Configuration (REQUIRED)
# =============================================================================

# Your OPNsense firewall URL (include https://)
OPNSENSE_URL=https://your-opnsense-firewall.domain.com

# OPNsense API credentials (generate these in OPNsense: System > Access > Users > API Keys)
OPNSENSE_API_KEY=your_opnsense_api_key_here
OPNSENSE_API_SECRET=your_opnsense_api_secret_here

# ⚠️ SSL Certificate Verification Bypass (DEVELOPMENT ONLY)
# Set to "true" to bypass SSL certificate validation for OPNsense API calls
# This is useful for development with self-signed certificates or IP-based connections
# ⚠️ WARNING: Only use in development/testing environments - NOT recommended for production
# For production, use proper SSL certificates and set to "false" or remove this variable
SKIP_SSL_VERIFICATION="false"

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

### DEBUG LEVEL -> SILENT(0),ERROR(1),WARN(2),INFO(3),DEBUG(4)
APP_DEBUG_LEVEL=SILENT

# Application port (default: 3000)
PORT=3000

# =============================================================================
# Domain Configuration (REQUIRED for Traefik and Reverse Proxies)
# =============================================================================

# Your domain name (WITHOUT protocol) - used by reverse proxies for routing
#
# Purpose:
#   - Used in docker-compose Traefik labels for routing rules
#   - Used by Traefik to determine which domain to route to this application
#   - Used for SSL certificate generation (must match DNS provider domain)
#
# IMPORTANT: This must match the domain portion of NEXTAUTH_URL (without https://)
#   - DOMAIN=your-instrada-ogm.com
#   - NEXTAUTH_URL=https://your-instrada-ogm.com
#
# Why both variables exist:
#   - DOMAIN: Used by docker-compose for Traefik routing labels (no protocol)
#   - NEXTAUTH_URL: Used by the application for authentication (with protocol)
#
# This must also match DOMAIN in traefik/runtime/.env.traefik for SSL certificates
#
# Example: your-instrada-ogm.com
DOMAIN=your-instrada-ogm.com

# -----------------------------------------------------------------------------
# Traefik Configuration
# -----------------------------------------------------------------------------
# NOTE: Additional Traefik configuration is in traefik/runtime/.env.traefik
# This includes:
#   - DNS_PROVIDER (cloudflare, route53, digitalocean, etc.)
#   - DNS provider credentials
#   - LETSENCRYPT_EMAIL
#   - CLOUDFLARE_DNS_API_TOKEN
#   - ACME_SERVER (staging/production)
# Edit traefik/runtime/.env.traefik and run: cd traefik && ./generate-config.sh

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Choose ONE database backend: SQLite (default) or PostgreSQL
# See detailed comparison below

# --- SQLite Configuration (DEFAULT) ---
# SQLite is a file-based database, perfect for development and small deployments
# Pros:
#   ✅ Zero configuration - no separate database server needed
#   ✅ Perfect for development and testing
#   ✅ Single file database - easy to backup
#   ✅ No authentication required
#   ✅ Suitable for small to medium deployments
# Cons:
#   ❌ Limited concurrent write support
#   ❌ Not ideal for high-traffic production
#   ❌ Limited advanced features
# Use Case: Development, testing, small deployments

# SQLite database filename (optional, default: instrada-ogm.db)
SQLITE_DB_NAME=instrada-ogm.db

# SQLite database URL (uses SQLITE_DB_NAME variable) 
DATABASE_URL=file:/app/data/db/${SQLITE_DB_NAME}

# --- PostgreSQL Configuration (RECOMMENDED FOR PRODUCTION) ---
# PostgreSQL is a powerful relational database, recommended for production
# Pros:
#   ✅ Excellent for high-traffic production environments
#   ✅ Advanced features (JSONB, full-text search, etc.)
#   ✅ Unlimited concurrent connections
#   ✅ Better performance with large datasets
#   ✅ Enterprise-grade reliability
#   ✅ Built-in replication and backup tools
# Cons:
#   ❌ Requires separate database server
#   ❌ More complex setup and maintenance
#   ❌ Higher resource requirements
# Use Case: Production, high-traffic, large datasets
#
# PostgreSQL Connection Details:
POSTGRES_USER=instrada-ogm-user
POSTGRES_PASSWORD=instrada-ogm-password
POSTGRES_HOST=instrada-ogm-postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=instrada-ogm

# PostgreSQL Connection String (use this for DATABASE_URL)
# Format: postgresql://user:password@host:port/database?schema=public
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
# Example: postgresql://instrada-ogm-user:password@localhost:5432/instrada-ogm?schema=public

# --- Database Selection Guide ---
# Development (Local):
#   SQLITE_DB_NAME=instrada-ogm-dev.db
#   DATABASE_URL=file:/app/data/db/${SQLITE_DB_NAME}
#
# Development (Docker with SQLite):
#   SQLITE_DB_NAME=instrada-ogm.db
#   DATABASE_URL=file:/app/data/db/${SQLITE_DB_NAME}
#
# Development (Docker with PostgreSQL):
#   DATABASE_URL=postgresql://instrada-ogm-user:password@instrada-ogm-postgres-db:5432/instrada-ogm?schema=public
#
# Production (Small Deployment):
#   SQLITE_DB_NAME=instrada-ogm.db
#   DATABASE_URL=file:/app/data/db/${SQLITE_DB_NAME}
#
# Production (Large Deployment):
#   DATABASE_URL=postgresql://user:password@postgres-host:5432/instrada-ogm?schema=public

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# ------------------
# HTTP/HTTPS Enforcement Control (OPTIONAL)
# Controls whether HTTP connections are allowed or if HTTPS is enforced
ALLOW_HTTP=false

# Purpose: Environment-based HTTP/HTTPS security configuration
# Values:
#   - true: Allow HTTP connections (DEVELOPMENT MODE)
#     * Disables HTTPS enforcement in security headers
#     * Removes 'upgrade-insecure-requests' from Content Security Policy
#     * Disables HTTP Strict Transport Security (HSTS)
#     * Allows HTTP images in CSP
#     * Sets NextAuth cookies with secure=false (allows HTTP authentication)
#     * Use for local development, testing, or HTTP-only environments
#   - false or unset: Enforce HTTPS only (PRODUCTION MODE - DEFAULT)
#     * Enables full HTTPS enforcement in security headers
#     * Adds 'upgrade-insecure-requests' to Content Security Policy
#     * Enables HTTP Strict Transport Security (HSTS)
#     * Restricts images to HTTPS only in CSP
#     * Sets NextAuth cookies with secure=true (requires HTTPS for authentication)
#     * Use for production deployments with SSL/TLS certificates
# Security Implications:
#   - Development (ALLOW_HTTP=true): Lower security, suitable for local networks
#   - Production (ALLOW_HTTP=false): Maximum security, requires valid SSL certificate
# Examples:
#   Development: ALLOW_HTTP=true
#   Production:  ALLOW_HTTP=false (or leave unset)
# Default: false (secure mode) if not set
# ------------------
# NextAuth.js URL (your application's base URL WITH protocol)
#
# Purpose:
#   - NextAuth authentication redirects and callbacks
#   - Internal server-to-server API calls (if INTERNAL_APP_URL is not set)
#   - Application's public-facing URL that users access in their browser
#
# IMPORTANT: The domain portion (without https://) must match the DOMAIN variable
#   - NEXTAUTH_URL=https://your-instrada-ogm.com
#   - DOMAIN=your-instrada-ogm.com
#
# Why both NEXTAUTH_URL and DOMAIN exist:
#   - NEXTAUTH_URL: Used BY THE APPLICATION for authentication (includes protocol)
#   - DOMAIN: Used BY REVERSE PROXIES (Traefik) for routing rules (no protocol)
#
# Examples:
#   Development:  NEXTAUTH_URL="http://localhost:3000"
#   Production:   NEXTAUTH_URL="https://your-instrada-ogm.com"
#   With Traefik: NEXTAUTH_URL="https://your-instrada-ogm.com" AND DOMAIN=your-instrada-ogm.com
#
# Default: http://localhost:3000 if not set
NEXTAUTH_URL="https://instrada-ogm.example.com"

# ------------------
# Internal application URL (OPTIONAL - Advanced Configuration)
# Only set this if you need a DIFFERENT URL for internal server-to-server API calls
# than the public NEXTAUTH_URL (e.g., in containerized deployments)
#
# Smart Fallback Behavior:
#   1. If INTERNAL_APP_URL is set → Use it for internal API calls
#   2. If INTERNAL_APP_URL is NOT set → Fall back to NEXTAUTH_URL
#   3. If both are unset → Default to http://localhost:3000
#
# Use Cases for Setting INTERNAL_APP_URL Separately:
#   - Docker/Kubernetes: Internal calls use container names (http://app:3000)
#     while external access uses domain (https://example.com)
#   - Different protocols: Internal calls over HTTP while external uses HTTPS
#   - Network isolation: Internal calls on private network, external on public
#
# Examples:
#   Docker: INTERNAL_APP_URL="http://app:3000"
#   Kubernetes: INTERNAL_APP_URL="http://instrada-ogm-service:3000"
#   Same as NEXTAUTH_URL: Leave this commented out
#
# Default: Falls back to NEXTAUTH_URL if not set
# INTERNAL_APP_URL="http://localhost:${PORT}"

# ------------------
# NextAuth Secret (REQUIRED)
# Generate a strong secret using `openssl rand -base64 32` or similar
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_a_secure_random_string

#Critical security environment variable used by NextAuth.js for cryptographic operations. Here's what it does:
#Purpose
#JWT Signing: Used to sign and verify JSON Web Tokens (JWTs) for user sessions
#Session Security: Ensures session tokens are cryptographically secure and tamper-proof
#Token Validation: Used to validate tokens in middleware and API routes
#Constructing verification email URLs (email verification, password reset)
#Redirecting users after authentication flows
#Used in authentication callbacks and redirects
# ------------------

# --- Local Credentials Login ---
# Enable/disable local email/password authentication
# Values: true (enabled) | false (disabled)
# Default: true
# Use Case: Enable for development, consider disabling in production if using SSO
AUTH_ALLOW_LOCAL_LOGIN=true

# Require email verification before local login is allowed
# Values: true (required) | false (optional)
# Default: false
# Note: Requires AUTH_SMTP_* configuration for email sending
# Note: This only applies to local (email/password) authentication, not OIDC/SSO
AUTH_REQUIRE_VERIFIED_EMAIL_LOCAL="false"


# Enable Two-Factor Authentication (2FA) for local logins
# Values: true (enabled) | false (disabled)
# Default: true
# Note: Users must set up 2FA in their account settings
AUTH_ALLOW_LOCAL_2FA="true"

# Minimum password length for user registration and password changes
# Values: integer (minimum 8 recommended)
# Default: 8
# Security Note: Longer passwords are more secure (12+ recommended for production)
AUTH_PASSWORD_MIN_LENGTH=8

# --- OIDC (SSO) Login ---
# Enable/disable OIDC/SSO authentication
# Values: true (enabled) | false (disabled)
# Default: false
# Note: Requires at least one OIDC provider to be configured below
AUTH_ALLOW_OIDC_LOGIN=false

# --- JWT Session Configuration ---
# JWT Session Maximum Age (in seconds)
# Defines how long a user's JWT session token remains valid before requiring re-authentication
# Default (if not set): 2592000 seconds (30 days)
# Examples:
#   3600 = 1 hour
#   86400 = 1 day
#   604800 = 1 week
#   2592000 = 30 days (NextAuth.js default)
# Note: This applies to both local and SSO authentication methods
# Uncomment and set to customize the session duration
# SSO_MAX_AGE=2592000

# -----------------------------------------------------------------------------
# Backup & Security Configuration
# -----------------------------------------------------------------------------
# Encryption key for backup files (generate a secure 64-character hex string)
# GENERATE A KEY WITH "openssl rand -hex 32"
BACKUP_ENCRYPTION_SECRET_KEY=your_64_character_hex_encryption_key_for_backups

# -----------------------------------------------------------------------------
# SSO Provider Configuration - Authentik
# -----------------------------------------------------------------------------
AUTH_OIDC_PROVIDER_AUTHENTIK_ENABLED=false
AUTH_OIDC_PROVIDER_AUTHENTIK_CLIENT_ID="your_authentik_client_id"
AUTH_OIDC_PROVIDER_AUTHENTIK_CLIENT_SECRET="your_authentik_client_secret"
AUTH_OIDC_PROVIDER_AUTHENTIK_ISSUER="https://your-authentik-instance.com/application/o/InstradaOGM/"
AUTH_OIDC_PROVIDER_AUTHENTIK_DISPLAY_NAME="Authentik"
AUTH_OIDC_PROVIDER_AUTHENTIK_SCOPES="openid email profile"

# -----------------------------------------------------------------------------
# SSO Provider Configuration - Keycloak
# -----------------------------------------------------------------------------
AUTH_OIDC_PROVIDER_KEYCLOAK_ENABLED=false
AUTH_OIDC_PROVIDER_KEYCLOAK_CLIENT_ID="your_keycloak_client_id"
AUTH_OIDC_PROVIDER_KEYCLOAK_CLIENT_SECRET="your_keycloak_client_secret"
AUTH_OIDC_PROVIDER_KEYCLOAK_ISSUER="https://your-keycloak-instance.com/realms/your-realm"
AUTH_OIDC_PROVIDER_KEYCLOAK_DISPLAY_NAME="Keycloak"
AUTH_OIDC_PROVIDER_KEYCLOAK_SCOPES="openid email profile groups"

# -----------------------------------------------------------------------------
# SSO Provider Configuration - Microsoft Entra ID (Azure AD)
# -----------------------------------------------------------------------------
AUTH_OIDC_PROVIDER_MICROSOFT_ENABLED=false
AUTH_OIDC_PROVIDER_MICROSOFT_CLIENT_ID="your_microsoft_client_id"
AUTH_OIDC_PROVIDER_MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret"
AUTH_OIDC_PROVIDER_MICROSOFT_ISSUER="https://login.microsoftonline.com/your-tenant-id/v2.0"
AUTH_OIDC_PROVIDER_MICROSOFT_DISPLAY_NAME="Microsoft Entra ID"
AUTH_OIDC_PROVIDER_MICROSOFT_SCOPES="openid email profile User.Read GroupMember.Read.All Group.Read.All"

# -----------------------------------------------------------------------------
# Email Notifications (Optional)
# -----------------------------------------------------------------------------
# Email Server Configuration (for email verification, password reset, etc.)
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=25
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM_EMAIL="InstradaOGM<admin@example.com>"

# =============================================================================
# RUNTIME ENVIRONMENT
# =============================================================================

# Node.js environment mode
# Values: development | production
# Default: development
# Impact:
#   - development: Enables debug logging, hot reload, detailed error messages
#   - production: Optimized performance, minimal logging, error suppression
NODE_ENV=development

# =============================================================================
# COMPLETE ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# This section documents ALL available environment variables for quick lookup

# --- Application Metadata ---
# NEXT_PUBLIC_APP_VERSION          | string   | App version (auto-set from package.json)

# --- OPNsense Configuration ---
# OPNSENSE_URL                     | string   | OPNsense firewall URL (required)
# OPNSENSE_API_KEY                 | string   | OPNsense API key (required)
# OPNSENSE_API_SECRET              | string   | OPNsense API secret (required)
# SKIP_SSL_VERIFICATION            | boolean  | Bypass SSL verification (dev only)

# --- Application Settings ---
# PORT                             | number   | Application port (default: 3000)
# NODE_ENV                         | string   | Environment mode (development|production)
# APP_DEBUG_LEVEL                  | string   | Logging level (SILENT|ERROR|WARN|INFO|DEBUG)

# --- Database Configuration ---
# DATABASE_URL                     | string   | Database connection string (required)
# SQLITE_DB_NAME                   | string   | SQLite database filename (default: instrada-ogm.db)
# POSTGRES_USER                    | string   | PostgreSQL username
# POSTGRES_PASSWORD                | string   | PostgreSQL password
# POSTGRES_HOST                    | string   | PostgreSQL host
# POSTGRES_PORT                    | number   | PostgreSQL port (default: 5432)
# POSTGRES_DB                      | string   | PostgreSQL database name

# --- HTTP/HTTPS Configuration ---
# ALLOW_HTTP                       | boolean  | Allow HTTP (dev only, default: false)
# NEXTAUTH_URL                     | string   | Public app URL (required)
# INTERNAL_APP_URL                 | string   | Internal server URL (optional)

# --- Authentication & Security ---
# NEXTAUTH_SECRET                  | string   | JWT signing secret (required)
# AUTH_ALLOW_LOCAL_LOGIN           | boolean  | Enable local login (default: true)
# AUTH_REQUIRE_VERIFIED_EMAIL_LOCAL| boolean  | Require email verification for local login (default: false)
# AUTH_ALLOW_LOCAL_2FA             | boolean  | Enable 2FA (default: true)
# AUTH_PASSWORD_MIN_LENGTH         | number   | Min password length (default: 8)
# AUTH_ALLOW_OIDC_LOGIN            | boolean  | Enable OIDC/SSO (default: false)
# SSO_MAX_AGE                      | number   | Session max age in seconds (default: 2592000)

# --- Backup & Security ---
# BACKUP_ENCRYPTION_SECRET_KEY     | string   | Backup encryption key (64-char hex)

# --- Email Configuration ---
# AUTH_SMTP_HOST                   | string   | SMTP server hostname
# AUTH_SMTP_PORT                   | number   | SMTP server port
# AUTH_SMTP_USER                   | string   | SMTP username
# AUTH_SMTP_PASS                   | string   | SMTP password
# AUTH_SMTP_FROM_EMAIL             | string   | From email address

# --- OIDC Provider: Authentik ---
# AUTH_OIDC_PROVIDER_AUTHENTIK_ENABLED       | boolean | Enable Authentik
# AUTH_OIDC_PROVIDER_AUTHENTIK_CLIENT_ID     | string  | Authentik client ID
# AUTH_OIDC_PROVIDER_AUTHENTIK_CLIENT_SECRET | string  | Authentik client secret
# AUTH_OIDC_PROVIDER_AUTHENTIK_ISSUER        | string  | Authentik issuer URL
# AUTH_OIDC_PROVIDER_AUTHENTIK_DISPLAY_NAME  | string  | Display name in UI
# AUTH_OIDC_PROVIDER_AUTHENTIK_SCOPES        | string  | OAuth scopes

# --- OIDC Provider: Keycloak ---
# AUTH_OIDC_PROVIDER_KEYCLOAK_ENABLED        | boolean | Enable Keycloak
# AUTH_OIDC_PROVIDER_KEYCLOAK_CLIENT_ID      | string  | Keycloak client ID
# AUTH_OIDC_PROVIDER_KEYCLOAK_CLIENT_SECRET  | string  | Keycloak client secret
# AUTH_OIDC_PROVIDER_KEYCLOAK_ISSUER         | string  | Keycloak issuer URL
# AUTH_OIDC_PROVIDER_KEYCLOAK_DISPLAY_NAME   | string  | Display name in UI
# AUTH_OIDC_PROVIDER_KEYCLOAK_SCOPES         | string  | OAuth scopes

# --- OIDC Provider: Microsoft Entra ID (Azure AD) ---
# AUTH_OIDC_PROVIDER_MICROSOFT_ENABLED       | boolean | Enable Microsoft
# AUTH_OIDC_PROVIDER_MICROSOFT_CLIENT_ID     | string  | Microsoft client ID
# AUTH_OIDC_PROVIDER_MICROSOFT_CLIENT_SECRET | string  | Microsoft client secret
# AUTH_OIDC_PROVIDER_MICROSOFT_ISSUER        | string  | Microsoft issuer URL
# AUTH_OIDC_PROVIDER_MICROSOFT_DISPLAY_NAME  | string  | Display name in UI
# AUTH_OIDC_PROVIDER_MICROSOFT_SCOPES        | string  | OAuth scopes

# =============================================================================
# QUICK SETUP TEMPLATES
# =============================================================================

# --- Development (Local SQLite) ---
# ALLOW_HTTP=true
# NEXTAUTH_URL="http://localhost:3000"
# NODE_ENV=development
# APP_DEBUG_LEVEL=DEBUG
# SQLITE_DB_NAME=instrada-ogm-dev.db
# DATABASE_URL=file:/app/data/db/${SQLITE_DB_NAME}
# NEXTAUTH_SECRET=dev-secret-do-not-use-in-production

# --- Development (Docker with PostgreSQL) ---
# ALLOW_HTTP=true
# NEXTAUTH_URL="http://localhost:3000"
# NODE_ENV=development
# APP_DEBUG_LEVEL=DEBUG
# DATABASE_URL=postgresql://instrada-ogm-user:password@instrada-ogm-postgres-db:5432/instrada-ogm?schema=public
# NEXTAUTH_SECRET=dev-secret-do-not-use-in-production

# --- Production (SQLite) ---
# ALLOW_HTTP=false
# NEXTAUTH_URL="https://your-domain.com"
# NODE_ENV=production
# APP_DEBUG_LEVEL=ERROR
# SQLITE_DB_NAME=instrada-ogm.db
# DATABASE_URL=file:/app/data/db/${SQLITE_DB_NAME}
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# --- Production (PostgreSQL) ---
# ALLOW_HTTP=false
# NEXTAUTH_URL="https://your-domain.com"
# NODE_ENV=production
# APP_DEBUG_LEVEL=ERROR
# DATABASE_URL=postgresql://user:password@postgres-host:5432/instrada-ogm?schema=public
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
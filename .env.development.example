# ============================================================================
# InstradaOGM Development Environment Configuration - EXAMPLE FILE
# ============================================================================
# This file shows example configuration for LOCAL DEVELOPMENT ONLY.
# Copy this to .env.development.local to use these settings.
#
# IMPORTANT:
# - This file is for DEVELOPMENT with reverse proxy (HTTPS termination)
# - For local HTTP development, see .env.development.local.example
# - Never commit .env.development.local to version control
# ============================================================================

# ============================================================================
# HTTP/HTTPS Configuration for Development with Reverse Proxy
# ============================================================================

# Allow HTTP connections (required for development)
ALLOW_HTTP=true

# NextAuth URL - Use the HTTPS domain (reverse proxy handles HTTPS termination)
# The reverse proxy forwards https://your-instrada-ogm.com to http://192.168.1.151:9002
NEXTAUTH_URL="https://your-instrada-ogm.com"

# Internal Application URL - Use local IP for internal server-to-server calls
# This is used for API calls within the application (not exposed to browser)
INTERNAL_APP_URL="http://192.168.1.151:9002"

# Node environment - Set to development for hot reload and debug logging
NODE_ENV=development

# ============================================================================
# Debug Configuration
# ============================================================================

# Enable debug logging for development
APP_DEBUG_LEVEL=DEBUG

# ============================================================================
# Database Configuration
# ============================================================================

# Use SQLite for local development (file-based, no setup required)
DATABASE_URL=file:./data/db/dev.db

# ============================================================================
# Authentication Configuration
# ============================================================================

# NextAuth Secret - Use a test secret for development
# In production, generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-do-not-use-in-production-generate-with-openssl"

# Enable local credentials login for testing
AUTH_ALLOW_LOCAL_LOGIN=true

# ============================================================================
# OPNsense Configuration
# ============================================================================

# Point to your local/test OPNsense instance
OPNSENSE_URL=https://your-test-opnsense.local
OPNSENSE_API_KEY=your_test_api_key
OPNSENSE_API_SECRET=your_test_api_secret

# Allow self-signed certificates in development
SKIP_SSL_VERIFICATION="true"

# ============================================================================
# Backup Configuration
# ============================================================================

# Use a test encryption key for development
BACKUP_ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# Notes
# ============================================================================
# 
# This configuration assumes:
# 1. You have a reverse proxy (Nginx Proxy Manager) configured
# 2. The proxy forwards https://your-instrada-ogm.com to http://192.168.1.151:9002
# 3. The proxy sets X-Forwarded-Proto: https header
# 4. Your app is running on http://192.168.1.151:9002 (npm run dev)
#
# How it works:
# - Browser accesses: https://your-instrada-ogm.com (HTTPS)
# - Reverse proxy forwards to: http://192.168.1.151:9002 (HTTP)
# - App receives X-Forwarded-Proto: https header
# - NextAuth validates tokens correctly with ALLOW_HTTP=true
# - Cookies work because ALLOW_HTTP=true disables secure flag
#
# To use this configuration:
# 1. Copy this file to .env.development.local
# 2. Update OPNSENSE_URL, OPNSENSE_API_KEY, OPNSENSE_API_SECRET
# 3. Update INTERNAL_APP_URL if your IP is different
# 4. Run: npm run dev
#

# =============================================================================
# Data Folder Configuration (OPTIONAL BUT FOR DEV OUTSIDE A CONTAINER YOU WANT TO SET THIS)
# =============================================================================

# Custom data folder path for storing application data
# Purpose:
#   - Allows configuring where backups, temp files, service state, and database are stored
#   - Useful for development with custom data locations
#   - Useful for non-containerized deployments following system conventions
#
# Values:
#   - Absolute path: /var/lib/instrada-ogm/data (used as-is)
#   - Relative path: ./custom-data (resolved relative to application root)
#   - Not set: Uses './data' (default, maintains backward compatibility)
#
# Examples:
#   Development: DATA_FOLDER_PATH=./dev-data
#   Linux system: DATA_FOLDER_PATH=/var/lib/instrada-ogm/data
#   Docker: Leave unset (uses default './data' which maps to container volume)
DATA_FOLDER_PATH="/path_to_your_project/data"